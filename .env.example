# ==============================================================================
# KONFIGURASI DATABASE SUPABASE (SANGAT DIREKOMENDASIKAN UNTUK 100+ PRODUK)
# ==============================================================================
# 1. Buka https://supabase.com -> Buat akun & Project Baru (100% GRATIS).
# 2. Buka menu "Project Settings" -> "API".
# 3. Salin "Project URL" dan "anon / public key" ke bawah ini:

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Opsional) Service Role Key untuk akses server bypass RLS:
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# DATABASE CLOUD CADANGAN (UPSTASH KV / REDIS)
# ==============================================================================
KV_REST_API_URL=
KV_REST_API_TOKEN=
